# Copiar a .env para desarrollo local. NUNCA versionar .env con valores reales.
# Estas variables son leidas por Vite (import.meta.env).

# Habilita los perfiles de prueba y el selector de rol en el header.
VITE_USE_MOCK_AUTH=true

# Perfil inicial cuando se usa auth mock: completo | solo-subir | solo-revisar | oficial | auditor | denegado
VITE_MOCK_ADMIN=false
VITE_MOCK_DENY=false

# La API de desarrollo (server/dev-server.mjs) NO lee este archivo.
# Configurar API_PORT y ISEP_DEV_SECRET en el entorno del proceso antes de npm run dev:api.
# Ejemplo PowerShell:
#   $env:API_PORT = '3001'
#   $env:ISEP_DEV_SECRET = 'valor-solo-local'
